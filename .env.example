# =============================================================================
# HireFlow - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# -----------------------------------------------------------------------------
# Database (used by backend)
# -----------------------------------------------------------------------------
# DB_URL=jdbc:mysql://mysql:3306/job_platform_dev?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USERNAME=jobapp
# DB_PASSWORD=jobapp123

# -----------------------------------------------------------------------------
# JWT (used by backend)
# -----------------------------------------------------------------------------
# JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-characters
# JWT_EXPIRATION_MS=86400000

# -----------------------------------------------------------------------------
# CORS (used by backend)
# -----------------------------------------------------------------------------
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Email / SMTP (used by backend for password reset emails)
# -----------------------------------------------------------------------------
# Set MAIL_ENABLED=true and configure SMTP to send real emails.
# When MAIL_ENABLED=false (default), reset URLs are logged to backend console.

# MAIL_ENABLED=false
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_FROM=noreply@hireflow.com
# MAIL_RESET_URL_BASE=http://localhost:3000/reset-password

# -----------------------------------------------------------------------------
# AI (used by backend for resume parsing and matching)
# -----------------------------------------------------------------------------
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
