# ===========================================
# AI-Powered Job & Recruitment Platform
# Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file to version control.

# --- Database ---
DB_NAME=job_platform_dev
DB_URL=jdbc:mysql://localhost:3306/job_platform_dev?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=
DB_PORT=3306

# --- JWT Authentication ---
# Must be at least 32 characters for HS256
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRATION_MS=86400000

# --- AI Integration (Optional) ---
# Leave empty to use deterministic fallbacks
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=4000
AI_REQUESTS_PER_HOUR=30
AI_ANALYSIS_PER_DAY=50
AI_REQUEST_TIMEOUT_MS=30000

# --- Server ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api
FRONTEND_PORT=3000
