# ===========================================
# Backend Environment Configuration
# ===========================================
# Copy to .env and configure for your environment.

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/job_platform?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# --- Server ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# --- JWT (min 32 chars, generate: openssl rand -base64 48) ---
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING_MIN_32_CHARS
JWT_EXPIRATION_MS=86400000

# --- AI (optional, leave empty for fallback) ---
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
