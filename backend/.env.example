# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/job_platform_dev?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# Server Configuration
SERVER_PORT=8080

# Spring Profile (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# Application Secrets (for future use)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION_MS=86400000

# AI Service Keys (for future use)
OPENAI_API_KEY=your_openai_api_key_here
